# Copy to .env and adjust. Used by compose.yaml.

# Required: password for the bundled PostgreSQL database.
# Use letters and digits only (it goes into a database URL).
POSTGRES_PASSWORD=change-me

# Port the app is published on.
GS1_SCANNER_PORT=8000

# Set to true once the app is served over HTTPS.
GS1_SCANNER_SECURE_COOKIES=false

# Optional: regular expression that SKUs must match, e.g. [A-Za-z0-9]{5,6}.
# Empty means 1-40 letters, digits, '.', '_' or '-'.
GS1_SCANNER_SKU_PATTERN=

# Stock expiring within this many days is flagged.
GS1_SCANNER_EXPIRY_WARNING_DAYS=30

# Optional: network label printer (Zebra or ZPL-compatible), "host" or "host:port".
# Leave empty to only download labels.
GS1_SCANNER_ZEBRA_PRINTER=

# Thermal label printer resolution (203, 300 or 600) and label size (4x6 or 100x150).
GS1_SCANNER_LABEL_DPI=203
GS1_SCANNER_LABEL_SIZE=4x6
